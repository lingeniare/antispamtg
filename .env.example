# Telegram
BOT_TOKEN=123456:ABC-your-bot-token
# AI Provider — VEGA (default, https://api.vega.chat) или OpenRouter (https://openrouter.ai)
# Разница только в base URL, API совместимы (OpenAI-compatible)
VEGA_API_KEY=vk-xxxxxxxx
# Для VEGA: https://api.vega.chat/v1
# Для OpenRouter: https://openrouter.ai/api/v1
VEGA_BASE_URL=https://api.vega.chat/v1
VEGA_MODEL=z-ai/glm-5.3-flash
# Vision-модель для картинок/стикеров/превью видео; пусто = VEGA_MODEL
# (glm-5.3-flash уже умеет image+video; дешёвые альтернативы: qwen/qwen3.7-flash, google/gemini-2.5-flash-lite)
VEGA_VISION_MODEL=

# Бот
ALLOWED_CHATS=-1001234567890,-100987654321  # через запятую: группы/каналы для фильтрации (ID или @username)
WHITELIST_USERS=12345678,87654321            # user_id через запятую — не фильтруются
DEFAULT_LANGUAGE=ru
ADMIN_USER_IDS=12345678                      # админы бота (могут менять настройки в ЛС)

# Фильтры
FILTER_PROMPT_PATH=config/filter_prompt.txt
DELETE_SPAM=true
# permanent — перманентный мьют с первого нарушения; progressive — эскалация 1д/7д/пермач
MUTE_POLICY=permanent
BAN_ON_REPEAT_SPAM=false
# always — все медиа через vision; new_users — новые юзеры+форварды; suspect — +ссылка в подписи; off
VISION_MODE=suspect
# испытательный срок: юзер «новый» пока < PROBATION_HOURS ч или < PROBATION_MSGS сообщений
PROBATION_HOURS=24
PROBATION_MSGS=5
# сканировать bio/имя при входе: ссылка+запретка в профиле = мьют, только ссылка = продлённый probation
BIO_SCAN=true
# flood-лимит: >RATE_LIMIT_COUNT сообщений за RATE_WINDOW_SEC = спам без LLM
RATE_LIMIT_COUNT=6
RATE_WINDOW_SEC=10

# Личность ВЕГА — отвечает на @mention, ответы ей, «вега» в тексте; ЛС — админы/whitelist
CHAT_ENABLED=true
VEGA_CHAT_MODEL=            # пусто = VEGA_MODEL; суффикс :online = поиск ВСЕГДА, без него — поиск по необходимости
CHAT_PROMPT_PATH=config/chat_prompt.txt
CHAT_WEB_SEARCH=false       # true → к модели добавляется :online (веб-поиск OpenRouter)
CHAT_MAX_TOKENS=20000       # бюджет reasoning+ответ+image; «короткий ответ» задаёт промпт, а не этот лимит
CHAT_AMBIENT_PCT=0          # % сообщений без триггера, которые ВЕГА сама посмотрит и решит ответить (каждое = 1 LLM-вызов)

# Даунтайм
DROP_PENDING_UPDATES=false  # false = после падения доесть буфер TG (~24ч) и вычистить спам задним числом; true = выбросить
