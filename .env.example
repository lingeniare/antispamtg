# Telegram
BOT_TOKEN=123456:ABC-your-bot-token
# AI Provider — VEGA (default, https://api.vega.chat) или OpenRouter (https://openrouter.ai)
# Разница только в base URL, API совместимы (OpenAI-compatible)
VEGA_API_KEY=vk-xxxxxxxx
# Для VEGA: https://api.vega.chat/v1
# Для OpenRouter: https://openrouter.ai/api/v1
VEGA_BASE_URL=https://api.vega.chat/v1
VEGA_MODEL=gpt-4o-mini
# Альтернативы: qwen/qwen3-8b, claude-3.5-sonnet, gemini-2.0-flash, deepseek-chat и т.д.
# Для OpenRouter модели с префиксом: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet и т.д.

# Бот
ALLOWED_CHATS=-1001234567890,-100987654321  # через запятую: группы/каналы для фильтрации (ID или @username)
WHITELIST_USERS=12345678,87654321            # user_id через запятую — не фильтруются
DEFAULT_LANGUAGE=ru
ADMIN_USER_IDS=12345678                      # админы бота (могут менять настройки в ЛС)

# Фильтры
FILTER_PROMPT_PATH=config/filter_prompt.txt
CAPTCHA_TIMEOUT_SEC=120
DELETE_SPAM=true
MUTE_ON_CAPTCHA_FAIL=true
BAN_ON_REPEAT_SPAM=true
